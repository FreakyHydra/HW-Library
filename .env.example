# Browser API base. Use /api in production. Leave empty to use presentation fixtures.
VITE_HW_LIBRARY_API_URL=
VITE_DISCORD_INVITE_URL=

# Orbis API service
NODE_ENV=development
PORT=8789
APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://orbis:change-me@127.0.0.1:5432/orbis
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=orbis.sid
TRUST_PROXY=false

# Discord OAuth application (Coda)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5174/api/auth/discord/callback
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs, never role names.
# Adult roles can view restricted records. Creator roles can create and edit owned records.
DISCORD_ADULT_ROLE_IDS=
DISCORD_CREATOR_ROLE_IDS=
